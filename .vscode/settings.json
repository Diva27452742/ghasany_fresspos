{
    "liveServer.settings.port": 5503,

    // =====================================================
    //  COLOR DECORATOR — Kotak Warna Visual di Editor
    //  Semua kode warna (#hex, rgb, hsl, dll) akan tampil
    //  sebagai kotak warna langsung di samping kodenya.
    // =====================================================
    "editor.colorDecorators": true,
    "editor.colorDecoratorsLimit": 1000,

    // Aktifkan color decorator di semua tipe file
    "[css]": {
        "editor.colorDecorators": true
    },
    "[html]": {
        "editor.colorDecorators": true
    },
    "[javascript]": {
        "editor.colorDecorators": true
    },
    "[php]": {
        "editor.colorDecorators": true
    },

    // Tampilkan warna di IntelliSense / autocomplete
    "css.colorDecorators.enable": true
}